# Secrets — .env.example is the only env file that belongs in the repo.
.env
.env.*
!.env.example

# Go
/backend/bin/
/backend/tmp/
*.exe
*.test
*.out

# Embedded SPA build output — produced by the frontend build, never committed.
/backend/web/

# Node
node_modules/
/frontend/dist/
/frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Local infrastructure state
/deploy/data/
/deploy/*.local.yml

# Coverage & profiling
coverage.out
coverage.html
*.prof

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Log sesi kerja. Ditulis di docs/sessions/ dan sengaja tidak ikut ter-commit:
# isinya catatan proses — apa yang dicoba, apa yang salah, apa yang ditunggu —
# yang berguna untuk melanjutkan pekerjaan, bukan untuk dibaca pengunjung repo.
#
# Konsekuensinya disadari: klon baru tidak membawa riwayat sesi, jadi
# docs/progress.md adalah satu-satunya sumber yang ikut repo. Log sesi yang
# perlu dibagikan disalin ke vault, bukan dilepas dari daftar ini.
docs/sessions/
