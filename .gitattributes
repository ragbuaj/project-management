# Normalize line endings to LF in the repository. Without this, a Windows
# checkout commits CRLF and gofmt/eslint disagree with CI on Linux.
* text=auto eol=lf

*.go     text eol=lf
*.sql    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.sh     text eol=lf

*.png    binary
*.jpg    binary
*.ico    binary
*.woff2  binary
