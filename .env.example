# Copy to .env and fill in. This file is committed, so its values are always
# empty — including the ones that are not secret. See docs/environments.md for
# what each variable means.
#
# The list grows alongside the code that reads it. Variables no code reads yet
# are deliberately absent: forcing someone to supply a value for something
# nothing reads only produces a throwaway value, and throwaway values end up in
# production.

# Required. local | production
APP_ENV=

# Required. Public origin without a path, e.g. https://pm.example.com
# Must be https when APP_ENV=production — a Secure session cookie is never
# sent over http.
APP_BASE_URL=

# Optional. Defaults to :8080
HTTP_ADDR=

# Optional. debug | info | warn | error. Defaults to info
LOG_LEVEL=

# Optional. Defaults to 1048576 (1 MiB)
MAX_REQUEST_BYTES=
