# Copy to .env and fill in. This file is committed, so its values are always
# empty — including the ones that are not secret. See docs/environments.md for
# what each variable means.
#
# The list grows alongside the code that reads it. Variables no code reads yet
# are deliberately absent: forcing someone to supply a value for something
# nothing reads only produces a throwaway value, and throwaway values end up in
# production.

# --- Application ------------------------------------------------------------

# Required. local | production
APP_ENV=

# Required. Public origin without a path, e.g. https://pm.example.com
# Must be https when APP_ENV=production — a Secure session cookie is never
# sent over http.
APP_BASE_URL=

# Optional. Defaults to :8080
HTTP_ADDR=

# Optional. debug | info | warn | error. Defaults to info
LOG_LEVEL=

# Optional. Defaults to 1048576 (1 MiB)
MAX_REQUEST_BYTES=

# --- Database ---------------------------------------------------------------

# Required. postgres://user:password@host:port/database
# Locally this points at the compose service, e.g.
# postgres://pm:<password>@localhost:5432/pm?sslmode=disable
DATABASE_URL=

# Optional. Defaults to 20. Set it deliberately: ten application instances
# with a pool of 50 means 500 connections, and PostgreSQL runs one process per
# connection.
DATABASE_MAX_CONNS=

# --- Redis ------------------------------------------------------------------

# Required. redis://[:password@]host:port[/db], or rediss:// for TLS.
# Locally this points at the compose service, e.g. redis://localhost:6379
#
# Required even though the application keeps running when Redis is down: those
# are different failures. An unreachable Redis is handled at run time — realtime
# stops, charts are recomputed, and the login rate limit fails closed. A Redis
# nobody configured is a deployment that was never finished.
#
# A URL with no host is refused rather than defaulted, because the client
# library would quietly connect to localhost and the deployment would look
# healthy while talking to nothing.
REDIS_URL=

# --- Mail --------------------------------------------------------------------

# Required. The SMTP server invitations and password resets are sent through.
# Locally this is the compose Mailpit service: localhost.
SMTP_HOST=

# Optional. Defaults to 587, which is submission over STARTTLS and what every
# provider wants. Mailpit listens on 1025, so set it locally.
SMTP_PORT=

# Required. The address the installation sends as. A display name is kept:
# Project Management <no-reply@pm.example.com>
SMTP_FROM=

# Required when APP_ENV=production, optional locally.
#
# Mailpit accepts no credentials at all, so demanding them locally would only
# produce a throwaway value -- and throwaway values end up in production. Set
# both or neither; one without the other is refused at start-up, as is the pair
# over a connection nobody promised to encrypt.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- compose.yml ------------------------------------------------------------
# Read by Docker Compose, not by the application.

# Required by compose.yml. Any value locally; it never leaves your machine.
POSTGRES_PASSWORD=

# Optional. Both default to pm
POSTGRES_USER=
POSTGRES_DB=

# Optional. Override when a port is already taken.
POSTGRES_PORT=
REDIS_PORT=
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=
